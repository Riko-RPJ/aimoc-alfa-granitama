# Configuration reference only. Never commit real credentials.
# Vercel: set DATABASE_URL in the project's server environment settings.
# Local Node scripts: set variables in your shell or use Node --env-file.
# npm run dev uses its own embedded database when DATABASE_URL is unset.
DATABASE_URL=
PORT=4196
# Bootstrap writes generated account passwords only to this ignored local file.
ACCESS_FILE=.local/access.json
