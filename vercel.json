{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci --ignore-scripts",
  "regions": ["sin1"],
  "functions": {"api/index.mjs": {"maxDuration": 60}},
  "rewrites": [{"source": "/api/:path*", "destination": "/api/index?route=:path*"}, {"source": "/:path*", "destination": "/index.html"}],
  "headers": [{"source": "/(.*)", "headers": [
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"same-origin"},
    {"key":"Permissions-Policy","value":"camera=(self), microphone=(), geolocation=()"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; font-src 'self'; media-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"}
  ]}]
}
